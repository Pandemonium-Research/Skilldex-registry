# --- Turso (libSQL) — the registry database ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth ---
# Secret for signing session JWTs. Any long random string; rotating it logs everyone out.
AUTH_JWT_SECRET=

# GitHub OAuth App — the registry talks to GitHub directly and issues its own session token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub API token (for fetching SKILL.md — avoids rate limits)
GITHUB_TOKEN=

# --- Supabase (legacy) ---
# Still read by scripts/seed.ts and scripts/migrate-to-turso.ts. Keep these set until the
# nightly seeder is ported (migration backlog phase 8); rollback also depends on them.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (optional — for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deployed registry base URL, used by scripts/verify-api-parity.ts
SKILLDEX_REGISTRY_URL=
